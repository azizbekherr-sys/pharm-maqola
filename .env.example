# Maqola — Environment Variables
# Copy this file to .env.local and fill in the values.

# Required: Production site URL (no trailing slash)
# Used for canonical URLs, Open Graph, sitemap, robots.txt, JSON-LD
NEXT_PUBLIC_SITE_URL=https://maqola.uz

# Optional: Vercel Web Analytics
# Set to "true" to enable (requires @vercel/analytics package)
# NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Optional: Error monitoring DSN (e.g. Sentry)
# SENTRY_DSN=
